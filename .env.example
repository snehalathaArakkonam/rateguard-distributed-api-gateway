# Core application config
PORT=8080
APP_ENV=development
LOG_LEVEL=info

# Gateway service settings
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_RATE_ALGORITHM=token_bucket
GATEWAY_DEFAULT_TIER=FREE

# Reverse proxy targets
ORDERS_SERVICE_URL=http://orders-service:3001
INVENTORY_SERVICE_URL=http://inventory-service:3002
DASHBOARD_URL=http://dashboard:5173

# Redis
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# PostgreSQL
DATABASE_URL=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rateguard
POSTGRES_USER=rateguard
POSTGRES_PASSWORD=rateguard

# Admin auth
ADMIN_API_KEY=admin-key-123

# Service health timeouts
BACKEND_TIMEOUT_MS=4000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=15000

# Dashboard / socket.io
DASHBOARD_PORT=5173

# k6 load test
K6_BASE_URL=http://gateway:8080
K6_API_KEY=test-client-free
