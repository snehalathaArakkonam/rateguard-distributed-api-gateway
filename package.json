{
  "name": "rateguard-distributed-api-gateway",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "gateway",
    "services/orders",
    "services/inventory",
    "dashboard"
  ],
  "scripts": {
    "install:all": "npm install",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "lint": "npm --prefix gateway run lint",
    "build": "npm --prefix gateway run build && npm --prefix dashboard run build"
  }
}
